#!/usr/bin/env elixir
IO.read(:stdio, :eof)
prompt = List.last(System.argv())
[_, role] = Regex.run(~r/Machine: (planner|doer|validator)/, prompt)
call = length(Path.wildcard(Path.join(__DIR__, "call-#{role}-*.args"))) + 1
File.write!(Path.join(__DIR__, "call-#{role}-#{call}.args"), prompt)
File.write!(Path.join(__DIR__, "call-#{role}-#{call}.cwd"), File.cwd!())
setting = fn name ->
  case File.read(Path.join(__DIR__, name)) do
    {:ok, text} -> text
    _ -> ""
  end
end
mode = setting.(role <> "-mode")
preamble = setting.(role <> "-preamble")
if preamble != "", do: IO.puts(preamble)
plan = Path.join(File.cwd!(), ".factory/plan.md")
prose = mode == "prose-plan"
result = case role do
  "planner" ->
    if not File.exists?(plan) do
      File.mkdir_p!(Path.dirname(plan))
      File.write!(plan, if(prose, do: "First do alpha, then do beta.\n", else: "- [ ] alpha\n- [ ] beta\n"))
    end
    if String.contains?(prompt, "The task's work has been committed") do
      # This double checks the ordering contract, not just the final state.
      {dirty, 0} = System.cmd("git", ["status", "--porcelain", "--", "."])
      if dirty != "", do: raise("planner called before work was committed")
      text = File.read!(plan)
      [_, task] = Regex.run(~r/"task"\s*:\s*"([^"]+)"/, prompt)
      text = if prose do
        case text do
          "First do alpha, then do beta.\n" -> "Alpha is finished. Beta is next.\n"
          "Alpha is finished. Beta is next.\n" -> "All work is finished.\n"
        end
      else
        String.replace(text, "- [ ] #{task}", "- [x] #{task}", global: false)
      end
      File.write!(plan, text)
    end
    text = File.read!(plan)
    %{"complete" => if(prose, do: text == "All work is finished.\n", else: not String.contains?(text, "- [ ]"))}
  "doer" ->
    text = File.read!(plan)
    task = if prose do
      if String.starts_with?(text, "First"), do: "alpha", else: "beta"
    else
      [_, task] = Regex.run(~r/^- \[ \] (.+)$/m, text)
      task
    end
    file = if mode == "sentinel", do: "SENTINEL", else: "#{task}.txt"
    File.write!(file, "Work for #{task}\n")
    if String.contains?(prompt, "Separate game logic from terminal input") do
      File.write!(plan, text <> "  - [x] Separate game logic from terminal input\n")
    end
    %{"task" => task}
  "validator" ->
    if mode == "prose-result" do
      IO.puts("I cannot give you a structured verdict.")
      System.halt(0)
    end
    satisfied = mode != "never" and (mode != "retry" or call > 1)
    %{"satisfied" => satisfied, "findings" => if(satisfied, do: [], else: ["Separate game logic from terminal input"])}
end
IO.puts(IO.iodata_to_binary(:json.encode(result)))
