// Application shell: owns app state, routes actions to the game, and builds
// the view (a list of text lines) for the renderer.

import { BOARD_HEIGHT, BOARD_WIDTH, ROTATIONS, createGame, pieceCells } from './game.js';

export { BOARD_HEIGHT, BOARD_WIDTH };

// The whole display (borders, board, side panel, status, controls) must fit
// a standard 80x24 terminal.
export const VIEW_ROWS = 24;
export const VIEW_COLS = 80;
export const CONTROLS = 'Arrows/WASD move+rotate  Space drop  P pause  R restart  Q quit';

const FILLED = '[]';
const EMPTY = ' .';
const GHOST = '::';

// Returns `lines` unchanged when they fit a cols x rows terminal (or when the
// size is unknown), otherwise a short "resize" notice clipped to that size.
export function fitToTerminal(lines, cols, rows) {
  if (!cols || !rows) return lines;
  const needCols = Math.max(...lines.map((line) => line.length));
  const needRows = lines.length;
  if (cols >= needCols && rows >= needRows) return lines;
  return [
    'Terminal too small',
    `Need ${needCols}x${needRows}, have ${cols}x${rows}`,
    'Game paused. Resize, then P',
    'Q quits',
  ].slice(0, rows).map((line) => line.slice(0, cols));
}

export function createApp({ onQuit = () => {}, random, nextPiece } = {}) {
  const game = createGame({ random, nextPiece });
  const state = {
    paused: false,
    elapsedMs: 0,
    lastAction: null,
    game,
  };

  function handleAction(action) {
    state.lastAction = action;
    if (action === 'quit') {
      onQuit();
      return;
    }
    if (action === 'restart') {
      game.restart();
      state.paused = false;
      state.elapsedMs = 0;
      return;
    }
    if (game.state.gameOver) return;
    if (action === 'pause') {
      state.paused = !state.paused;
      return;
    }
    if (state.paused) return;
    switch (action) {
      case 'left': game.moveLeft(); break;
      case 'right': game.moveRight(); break;
      case 'rotate': game.rotate(1); break;
      case 'softDrop': game.softDrop(); break;
      case 'hardDrop': game.hardDrop(); break;
      default: break;
    }
  }

  function update(dtMs) {
    if (state.paused || game.state.gameOver) return;
    state.elapsedMs += dtMs;
    game.tick(dtMs);
  }

  function boardRows() {
    const g = game.state;
    const grid = g.board.map((row) => row.map((cell) => (cell ? FILLED : EMPTY)));
    if (!g.gameOver) {
      const ghostY = game.ghostY();
      for (const [x, y] of pieceCells({ ...g.current, y: ghostY })) {
        if (y >= 0 && grid[y][x] === EMPTY) grid[y][x] = GHOST;
      }
    }
    for (const [x, y] of pieceCells(g.current)) {
      if (y >= 0) grid[y][x] = FILLED;
    }
    return grid.map((row) => row.join(''));
  }

  function nextPreview() {
    const cells = ROTATIONS[game.state.next][0];
    const rows = [Array(4).fill('  '), Array(4).fill('  ')];
    const minY = Math.min(...cells.map(([, y]) => y));
    for (const [x, y] of cells) rows[y - minY][x] = FILLED;
    return rows.map((r) => r.join(''));
  }

  function statusMessage() {
    if (game.state.gameOver) return 'GAME OVER - press R to restart, Q to quit';
    if (state.paused) return 'PAUSED - press P to resume';
    return '';
  }

  function view() {
    const g = game.state;
    const preview = nextPreview();
    const side = [
      '',
      ' SCORE',
      ` ${g.score}`,
      '',
      ' LINES',
      ` ${g.lines}`,
      '',
      ' LEVEL',
      ` ${g.level}`,
      '',
      ' NEXT',
      ` ${preview[0]}`,
      ` ${preview[1]}`,
      '',
      ` Time ${Math.floor(state.elapsedMs / 1000)}s`,
      '',
      g.gameOver ? ' GAME OVER' : state.paused ? ' PAUSED' : '',
    ];
    const border = '+' + '-'.repeat(BOARD_WIDTH * 2) + '+';
    const rows = [border, ...boardRows().map((r) => `|${r}|`), border];
    const lines = rows.map((row, i) => (side[i] ? `${row}${side[i]}` : row));
    lines.push(statusMessage());
    lines.push(CONTROLS);
    return lines.slice(0, VIEW_ROWS).map((line) => line.slice(0, VIEW_COLS));
  }

  function pause() {
    if (!game.state.gameOver) state.paused = true;
  }

  return { state, handleAction, update, view, pause };
}
#!/usr/bin/env node
// Entry point for `npm start`: wires input, game loop, and rendering together.

import { realpathSync } from 'node:fs';
import { fileURLToPath, pathToFileURL } from 'node:url';

import { createApp, fitToTerminal } from './app.js';
import { startInput } from './input.js';
import { createLoop } from './loop.js';
import { createRenderer } from './renderer.js';

export function run({ stdin = process.stdin, stdout = process.stdout } = {}) {
  const renderer = createRenderer(stdout);
  let stopInput = () => {};
  let loop = null;
  let finished = false;

  function shutdown(code = 0) {
    if (finished) return;
    finished = true;
    loop?.stop();
    stopInput();
    renderer.stop();
    stdout.off?.('resize', onResize);
    process.off('SIGINT', onSignal);
    process.off('SIGTERM', onSignal);
    process.off('uncaughtException', onException);
    process.exitCode = code;
  }

  function onSignal() {
    shutdown(0);
  }

  function onException(err) {
    shutdown(1);
    console.error(err);
  }

  function onResize() {
    renderer.invalidate();
    draw();
  }

  // Draws the game, or a resize notice (pausing play) if the terminal is
  // too small to show the whole display.
  function draw() {
    const lines = app.view();
    const fitted = fitToTerminal(lines, stdout.columns, stdout.rows);
    if (fitted !== lines) app.pause();
    renderer.draw(fitted);
  }

  const app = createApp({ onQuit: () => shutdown(0) });
  loop = createLoop({
    update: (dt) => app.update(dt),
    render: draw,
  });

  renderer.start();
  stopInput = startInput(stdin, (action) => {
    app.handleAction(action);
    if (!finished) draw();
  });
  stdout.on?.('resize', onResize);
  loop.start();

  process.once('SIGINT', onSignal);
  process.once('SIGTERM', onSignal);
  process.once('uncaughtException', onException);

  return { app, shutdown };
}

// Only auto-start when executed directly (`npm start`, `node src/index.js`,
// or the npm bin symlink), never when imported as a module.
export function isMainModule(argv1 = process.argv[1], moduleUrl = import.meta.url) {
  if (!argv1) return false;
  try {
    return pathToFileURL(realpathSync(argv1)).href === pathToFileURL(realpathSync(fileURLToPath(moduleUrl))).href;
  } catch {
    return false;
  }
}

if (isMainModule()) run();
// Renders game frames to the terminal using ANSI escape sequences.

export const ESC = '\u001b[';
export const ENTER_ALT_SCREEN = `${ESC}?1049h`;
export const LEAVE_ALT_SCREEN = `${ESC}?1049l`;
export const HIDE_CURSOR = `${ESC}?25l`;
export const SHOW_CURSOR = `${ESC}?25h`;
export const CLEAR_SCREEN = `${ESC}2J`;
export const HOME = `${ESC}H`;
export const CLEAR_LINE = `${ESC}K`;
export const RESET = `${ESC}0m`;
export const MAX_ROWS = 24;

// Turns a list of text lines into one terminal frame: each line is drawn
// from the top-left and cleared to end of line, then leftover rows below
// are cleared so shrinking frames leave no residue. At most MAX_ROWS lines
// are drawn and no newline follows the last one, so the frame never scrolls.
export function composeFrame(lines) {
  const body = lines.slice(0, MAX_ROWS).map((line) => `${line}${RESET}${CLEAR_LINE}`).join('\r\n');
  return `${HOME}${body}${ESC}J`;
}

export function createRenderer(stdout) {
  let last = null;
  return {
    start() {
      stdout.write(ENTER_ALT_SCREEN + HIDE_CURSOR + CLEAR_SCREEN + HOME);
    },
    draw(lines) {
      const frame = composeFrame(lines);
      if (frame === last) return;
      last = frame;
      stdout.write(frame);
    },
    invalidate() {
      last = null;
      stdout.write(CLEAR_SCREEN);
    },
    stop() {
      stdout.write(RESET + SHOW_CURSOR + LEAVE_ALT_SCREEN);
    },
  };
}

