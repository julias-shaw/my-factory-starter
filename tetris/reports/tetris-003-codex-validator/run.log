    13	// Turns a list of text lines into one terminal frame: each line is drawn
    14	// from the top-left and cleared to end of line, then leftover rows below
    15	// are cleared so shrinking frames leave no residue.
    16	export function composeFrame(lines) {
    17	  const body = lines.map((line) => `${line}${RESET}${CLEAR_LINE}`).join('\r\n');
    18	  return `${HOME}${body}${ESC}J`;
