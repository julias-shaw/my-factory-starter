    23	  return {
    24	    start() {
    25	      stdout.write(ENTER_ALT_SCREEN + HIDE_CURSOR + CLEAR_SCREEN + HOME);
    26	    },
    27	    draw(lines) {
    28	      const frame = composeFrame(lines);
    29	      if (frame === last) return;
    30	      last = frame;
