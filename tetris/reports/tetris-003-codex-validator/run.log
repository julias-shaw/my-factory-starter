    38	// "\u001b[") so it can be joined with the next data event.
    39	export function splitPending(chunk) {
    40	  if (chunk.endsWith('\u001b')) return [chunk.slice(0, -1), '\u001b'];
    41	  if (chunk.endsWith('\u001b[')) return [chunk.slice(0, -2), '\u001b['];
    42	  return [chunk, ''];
