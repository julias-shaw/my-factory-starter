#!/usr/bin/env node
// Entry point for `npm start`: wires input, game loop, and rendering together.

import { realpathSync } from 'node:fs';
import { fileURLToPath, pathToFileURL } from 'node:url';

import { createApp } from './app.js';
import { startInput } from './input.js';
import { createLoop } from './loop.js';
import { createRenderer } from './renderer.js';

export function run({ stdin = process.stdin, stdout = process.stdout } = {}) {
  const renderer = createRenderer(stdout);
  let stopInput = () => {};
  let loop = null;
  let finished = false;

  function shutdown(code = 0) {
    if (finished) return;
    finished = true;
    loop?.stop();
    stopInput();
    renderer.stop();
    stdout.off?.('resize', onResize);
    process.off('SIGINT', onSignal);
    process.off('SIGTERM', onSignal);
    process.off('uncaughtException', onException);
    process.exitCode = code;
  }

  function onSignal() {
    shutdown(0);
  }

  function onException(err) {
    shutdown(1);
    console.error(err);
  }

  function onResize() {
    renderer.invalidate();
    renderer.draw(app.view());
  }

  const app = createApp({ onQuit: () => shutdown(0) });
  loop = createLoop({
    update: (dt) => app.update(dt),
    render: () => renderer.draw(app.view()),
  });

  renderer.start();
  stopInput = startInput(stdin, (action) => {
    app.handleAction(action);
    if (!finished) renderer.draw(app.view());
  });
  stdout.on?.('resize', onResize);
  loop.start();

  process.once('SIGINT', onSignal);
  process.once('SIGTERM', onSignal);
  process.once('uncaughtException', onException);

  return { app, shutdown };
}

// Only auto-start when executed directly (`npm start`, `node src/index.js`,
// or the npm bin symlink), never when imported as a module.
export function isMainModule(argv1 = process.argv[1], moduleUrl = import.meta.url) {
  if (!argv1) return false;
  try {
    return pathToFileURL(realpathSync(argv1)).href === pathToFileURL(realpathSync(fileURLToPath(moduleUrl))).href;
  } catch {
    return false;
  }
}

if (isMainModule()) run();
// A fixed-rate game loop. Calls update(dtMs) then render() on each tick.

export function createLoop({ update, render, intervalMs = 16, now = () => Date.now() }) {
  let timer = null;
  let lastTime = 0;

  function tick() {
    const t = now();
    const dt = t - lastTime;
    lastTime = t;
    update(dt);
    render();
  }

  return {
    start() {
      if (timer) return;
      lastTime = now();
      render();
      timer = setInterval(tick, intervalMs);
    },
    stop() {
      if (!timer) return;
      clearInterval(timer);
      timer = null;
    },
    get running() {
      return timer !== null;
    },
    tick,
  };
}
// Translates raw terminal keypresses into game actions.

const KEY_ACTIONS = new Map([
  ['\u001b[D', 'left'],
  ['\u001b[C', 'right'],
  ['\u001b[B', 'softDrop'],
  ['\u001b[A', 'rotate'],
  ['a', 'left'],
  ['d', 'right'],
  ['s', 'softDrop'],
  ['w', 'rotate'],
  [' ', 'hardDrop'],
  ['p', 'pause'],
  ['r', 'restart'],
  ['q', 'quit'],
  ['\u0003', 'quit'], // Ctrl+C
]);

// Splits a chunk of input (which may contain several keys) into actions.
export function parseKeys(chunk) {
  const actions = [];
  let i = 0;
  while (i < chunk.length) {
    if (chunk[i] === '\u001b' && chunk[i + 1] === '[' && i + 2 < chunk.length) {
      const action = KEY_ACTIONS.get(chunk.slice(i, i + 3));
      if (action) actions.push(action);
      i += 3;
      continue;
    }
    const action = KEY_ACTIONS.get(chunk[i].toLowerCase());
    if (action) actions.push(action);
    i += 1;
  }
  return actions;
}

// Splits off a trailing, not-yet-complete escape sequence ("\u001b" or
// "\u001b[") so it can be joined with the next data event.
export function splitPending(chunk) {
  if (chunk.endsWith('\u001b')) return [chunk.slice(0, -1), '\u001b'];
  if (chunk.endsWith('\u001b[')) return [chunk.slice(0, -2), '\u001b['];
  return [chunk, ''];
}

// Puts stdin into raw mode and calls onAction for each recognized key.
// Returns a function that restores the terminal input state.
export function startInput(stdin, onAction) {
  const wasRaw = Boolean(stdin.isRaw);
  if (stdin.isTTY) stdin.setRawMode(true);
  stdin.setEncoding('utf8');
  let pending = '';
  const listener = (chunk) => {
    const [complete, rest] = splitPending(pending + String(chunk));
    pending = rest;
    for (const action of parseKeys(complete)) onAction(action);
  };
  stdin.on('data', listener);
  stdin.resume();
  return () => {
    stdin.off('data', listener);
    if (stdin.isTTY) stdin.setRawMode(wasRaw);
    stdin.pause();
  };
}
// Renders game frames to the terminal using ANSI escape sequences.

export const ESC = '\u001b[';
export const ENTER_ALT_SCREEN = `${ESC}?1049h`;
export const LEAVE_ALT_SCREEN = `${ESC}?1049l`;
export const HIDE_CURSOR = `${ESC}?25l`;
export const SHOW_CURSOR = `${ESC}?25h`;
export const CLEAR_SCREEN = `${ESC}2J`;
export const HOME = `${ESC}H`;
export const CLEAR_LINE = `${ESC}K`;
export const RESET = `${ESC}0m`;

// Turns a list of text lines into one terminal frame: each line is drawn
// from the top-left and cleared to end of line, then leftover rows below
// are cleared so shrinking frames leave no residue.
export function composeFrame(lines) {
  const body = lines.map((line) => `${line}${RESET}${CLEAR_LINE}`).join('\r\n');
  return `${HOME}${body}${ESC}J`;
}

export function createRenderer(stdout) {
  let last = null;
  return {
    start() {
      stdout.write(ENTER_ALT_SCREEN + HIDE_CURSOR + CLEAR_SCREEN + HOME);
    },
    draw(lines) {
      const frame = composeFrame(lines);
      if (frame === last) return;
      last = frame;
      stdout.write(frame);
    },
    invalidate() {
      last = null;
      stdout.write(CLEAR_SCREEN);
    },
    stop() {
      stdout.write(RESET + SHOW_CURSOR + LEAVE_ALT_SCREEN);
    },
  };
}

